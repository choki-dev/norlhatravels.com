---
// Tailor-made — copy: Content & Concept doc, Page 5.
// Title banner → it begins with a conversation (photo collage + questions) → the process (accordion + photo)
// → what can your journey include (icon tiles that also fill in the form) → personally curated (statement)
// → no template, no fixed formula + the enquiry form.
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import EnquiryForm from '../components/EnquiryForm.astro';

const questions = ['What brings you to Bhutan?', 'What do you want to discover?', 'How do you like to travel?', 'What would make your journey memorable?'];
const steps = [
  { t: 'Tell us what inspires you', p: 'Share your interests, travel dates, preferred pace, expectations and the experiences you have in mind.' },
  { t: 'We curate', p: 'We combine your ideas with our knowledge of Bhutan to create a thoughtful itinerary.' },
  { t: 'Refine', p: 'We adjust the pace, accommodation, experiences and details until the journey feels right.' },
  { t: 'Experience', p: 'Once you arrive, we take care of the journey while you concentrate on being present.' },
];
const includes = [
  { icon: 'temple', t: 'Culture and heritage' },
  { icon: 'mountain', t: 'Himalayan trekking' },
  { icon: 'lotus', t: 'Wellness and spirituality' },
  { icon: 'camera', t: 'Photography' },
  { icon: 'bowl', t: 'Food and local cuisine' },
  { icon: 'flags', t: 'Festivals' },
  { icon: 'leaf', t: 'Wildlife and nature' },
  { icon: 'people', t: 'Family experiences' },
  { icon: 'heart', t: 'Romance and honeymoons' },
  { icon: 'glass', t: 'Private celebrations' },
  { icon: 'moon', t: 'Time away from everything' },
];
---

<Base title="Tailor-Made Journeys" description="Don't choose a package. Create a journey. Tailor-made private travel in Bhutan, planned with you in four simple steps.">
  <Hero photo="tailor-hero" alt="A traveler looking out over a Bhutanese valley" tone="dawn" eyebrow="Tailor-made journeys · Your Bhutan. Your way." title="Don’t choose a package. <em>Create a journey.</em>" />

  <!-- It begins with a conversation -->
  <section class="section">
    <div class="wrap duo">
      <div class="duo-media reveal">
        <Photo name="hospitality" alt="A warm conversation over tea" tone="dawn" sizes="(max-width: 860px) 75vw, 34vw" />
        <Photo name="way-curated" alt="Planning a journey through Bhutan" tone="valley" sizes="(max-width: 860px) 60vw, 26vw" />
      </div>
      <div class="duo-text reveal">
        <span class="kicker">It begins with a conversation</span>
        <h2 class="big">A great journey begins before you arrive.</h2>
        <ul class="questions">{questions.map((q) => <li>{q}</li>)}</ul>
        <p class="note">We start there.</p>
      </div>
    </div>
  </section>

  <!-- The process -->
  <section class="section bg-tint">
    <div class="wrap acc">
      <div class="acc-text reveal">
        <span class="kicker">The process</span>
        <h2 class="big">Four steps to <em>your</em> journey.</h2>
        <div class="acc-list">
          {steps.map((st, i) => (
            <details open={i === 0}>
              <summary>{st.t}<small>0{i + 1}</small></summary>
              <p>{st.p}</p>
            </details>
          ))}
        </div>
      </div>
      <div class="acc-media reveal">
        <Photo name="tailor-includes" alt="A private journey through the Bhutanese mountains" tone="dusk" sizes="(max-width: 860px) 90vw, 45vw" />
        <div class="acc-stats">
          <div><b>4</b><span>Simple steps, from first idea to arrival</span></div>
          <div><b>100%</b><span>Private — never part of a group</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- What can your journey include -->
  <section class="section">
    <div class="wrap">
      <div class="head center reveal">
        <span class="kicker">What can your journey include?</span>
        <h2 class="big">There is no required formula.</h2>
        <p class="lede">Choose anything that interests you — we will add it to your enquiry below.</p>
      </div>
      <div class="picks" data-picks>
        {includes.map((x, i) => (
          <button type="button" class="pick reveal" style={`transition-delay:${(i % 4) * 60}ms`} aria-pressed="false" data-value={x.t}>
            <Icon name={x.icon} size={44} />
            <span>{x.t}</span>
          </button>
        ))}
        <a href="#enquire" class="pick pick-more reveal" style="transition-delay:180ms">
          <Icon name="chat" size={44} />
          <span>Something else? Tell us below</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Personally curated -->
  <section class="stmt bg-2">
    <div class="wrap reveal">
      <span class="kicker">Your journey, personally curated</span>
      <h2>You decide what matters. <em>We take care of the details.</em></h2>
      <div class="lines"><p>We arrange the elements of your journey around your preferences and availability, including accommodation, transportation, guiding and experiences.</p></div>
    </div>
  </section>

  <!-- Enquiry -->
  <section class="section" id="build">
    <div class="wrap enq">
      <div class="reveal">
        <span class="kicker">No template. No fixed formula.</span>
        <h2 class="big t-gap">Simply <em>your</em> Bhutan.</h2>
        <p>Tell us as much or as little as you like. We will reply personally with ideas and a first outline of your journey.</p>
        <ul class="checks">
          {steps.map((st) => <li>{st.t}</li>)}
        </ul>
      </div>
      <div class="panel form-panel reveal"><EnquiryForm /></div>
    </div>
  </section>
</Base>

<script>
  // Interest tiles: write the chosen interests into the first line of the enquiry message.
  const picks = document.querySelector<HTMLElement>('[data-picks]');
  const msg = document.querySelector<HTMLTextAreaElement>('#enquire textarea[name="message"]');
  if (picks && msg) {
    const PREFIX = 'I am interested in: ';
    picks.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.pick');
      if (!btn) return;
      btn.setAttribute('aria-pressed', btn.getAttribute('aria-pressed') === 'true' ? 'false' : 'true');
      const chosen = [...picks.querySelectorAll<HTMLButtonElement>('.pick[aria-pressed="true"]')].map((b) => b.dataset.value!.toLowerCase());
      const rest = msg.value.split('\n').filter((l) => !l.startsWith(PREFIX)).join('\n').replace(/^\n+/, '');
      msg.value = (chosen.length ? `${PREFIX}${chosen.join(', ')}.\n` : '') + rest;
    });
  }
</script>

<style>
  .questions { margin-top: 8px; border-top: 1px solid var(--line); }
  .questions li { padding: 15px 0; border-bottom: 1px solid var(--line); font-family: var(--serif); font-size: clamp(21px, 1.9vw, 26px); line-height: 1.3; color: var(--heading); }
  .t-gap { margin: 16px 0 22px; }

  .picks { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); }
  .pick { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 16px; min-height: 180px; padding: 28px 18px; border: 0; background: #fff; font-family: var(--serif); font-size: clamp(19px, 1.6vw, 22px); line-height: 1.25; color: var(--heading); cursor: pointer; transition: background 0.35s var(--ease), color 0.35s var(--ease); }
  .pick :global(.icon) { color: var(--saffron); transition: color 0.35s var(--ease), transform 0.5s var(--ease); }
  .pick:hover :global(.icon) { transform: translateY(-4px); }
  .pick:hover { background: var(--paper-2); }
  .pick[aria-pressed='true'] { background: var(--saffron); color: #fff; }
  .pick[aria-pressed='true'] :global(.icon) { color: #fff; }
  .pick-more { font-style: italic; color: var(--saffron); }
  @media (max-width: 860px) { .picks { grid-template-columns: repeat(2, 1fr); } .pick { min-height: 150px; } }
  .form-panel { background: var(--paper-2); box-shadow: none; }
</style>
