---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Photo from '../components/Photo.astro';
import CtaBand from '../components/CtaBand.astro';
import { accommodation } from '../data/journeys.js';

const approach = [
  { t: 'We listen', p: ['Every traveler arrives with a different idea of Bhutan. Some come for culture. Some for the mountains. Some for spirituality. Some for adventure. Others simply want to slow down.', 'We begin by understanding what Bhutan means to you.'] },
  { t: 'We curate', p: ['We then shape an itinerary around your interests, pace, travel style and expectations.', 'The journey can be refined until it feels right.'] },
  { t: 'We connect', p: ['Bhutan is best experienced through its people.', 'Our journeys create opportunities to discover local culture, traditions, stories, food, crafts and everyday life.'] },
  { t: 'We coordinate', p: ['Behind every effortless journey is careful planning.', 'We coordinate accommodation, transportation, guiding, activities and the many details that make your time in Bhutan comfortable and seamless.'] },
];
---

<Base title="About NorLha" description="NorLha Tours & Travels creates private journeys for travelers who want to experience Bhutan personally, thoughtfully and at their own pace.">
  <Hero photo="about-hero" alt="A Bhutanese dzong set against forested mountains" tone="forest" eyebrow="About NorLha" title="Bhutan is our destination. <em>Your journey is our focus.</em>" />

  <section class="section">
    <div class="wrap split">
      <div class="reveal verse">
        <p>Bhutan is not simply somewhere to visit.</p>
        <p><em>It is a country to experience.</em></p>
      </div>
      <div class="reveal">
        <p class="lede">Its mountains, monasteries, villages, traditions, spirituality and people each reveal a different part of the Kingdom.</p>
        <p class="muted">At NorLha Tours and Travels, we create private journeys for travelers who want to experience Bhutan personally, thoughtfully and at their own pace.</p>
        <p class="muted">Our approach begins with a simple idea:</p>
        <p class="idea">Listen first. Then create.</p>
      </div>
    </div>
  </section>

  <section class="section bg-pine">
    <div class="wrap">
      <div class="head reveal">
        <span class="eyebrow">The NorLha approach</span>
        <h2 class="h2" style="margin-top:22px">Four simple commitments.</h2>
      </div>
      <div class="grid grid-4">
        {approach.map((a, i) => (
          <div class="pillar reveal" style={`transition-delay:${i * 90}ms`}>
            <span class="num">0{i + 1}</span>
            <h3>{a.t}</h3>
            {a.p.map((p) => <p>{p}</p>)}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <Photo name="freedom" alt="A traveler pausing on a forest trail in Bhutan" tone="valley" class="tall reveal" sizes="(max-width: 860px) 100vw, 50vw" />
      <div class="reveal">
        <span class="eyebrow">Travel with freedom</span>
        <h2 class="h2" style="margin:22px 0 28px">We believe private travel should give you choice.</h2>
        <ul class="choices">
          <li>Choice of pace.</li>
          <li>Choice of experiences.</li>
          <li>Choice of accommodation.</li>
          <li>Choice of how you spend your time.</li>
        </ul>
        <p class="muted">Rather than asking you to fit into a predetermined journey, we create the journey around you.</p>
      </div>
    </div>
  </section>

  <section class="section bg-2">
    <div class="wrap">
      <div class="head reveal">
        <span class="eyebrow">Comfort without compromising character</span>
        <h2 class="h2" style="margin-top:22px">The right balance of comfort, privacy, authenticity and flexibility.</h2>
        <p class="lede">From intimate boutique properties to distinguished luxury hotels and retreats, we can arrange accommodation according to your preferences, itinerary and availability. The same applies to transportation and guiding.</p>
      </div>
      <div class="grid grid-4">
        {accommodation.map((a, i) => (
          <div class="tier reveal" style={`transition-delay:${i * 90}ms`}>
            <span class="eyebrow">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="h4">{a.tier}</h3>
            <p class="muted">{a.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap-narrow center reveal">
      <span class="eyebrow">Our promise</span>
      <h2 class="h2" style="margin:22px 0 32px">We don’t want to simply show you Bhutan. <em>We want to help you experience it.</em></h2>
      <div class="verse promise">
        <p>To travel through its landscapes with time to appreciate them.</p>
        <p>To understand its traditions.</p>
        <p>To meet its people.</p>
        <p>To discover places beyond the obvious.</p>
        <p>And to return home with memories that feel distinctly your own.</p>
      </div>
      <span class="ornament"></span>
      <p class="eyebrow">Your Bhutan. Your way.</p>
      <div style="margin-top:40px"><a href="/the-norlha-way/" class="link">Read the NorLha Way <span>→</span></a></div>
    </div>
  </section>

  <CtaBand title="Let us create a journey <em>around you.</em>" text="Tell us what Bhutan means to you, and we will shape the rest." photo="about-cta" tone="dawn" />
</Base>

<style>
  .idea { font-family: var(--serif); font-style: italic; font-size: clamp(28px, 3vw, 40px); color: var(--maroon); margin-top: 14px; }
  :global(.tall) { aspect-ratio: 4 / 5; }
  .choices { margin-bottom: 28px; }
  .choices li { font-family: var(--serif); font-size: clamp(24px, 2.2vw, 30px); padding: 12px 0; border-bottom: 1px solid var(--line); }
  .tier { background: var(--paper); padding: 34px 30px; border-top: 2px solid var(--saffron); }
  .tier h3 { margin: 12px 0 14px; }
  .tier p { font-size: 15.5px; }
  .promise { font-size: clamp(20px, 1.9vw, 25px); color: var(--ink-soft); }
</style>
