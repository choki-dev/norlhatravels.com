  /* Keyboard buttons — appear when focused */
  .c-btn { position: absolute; top: 50%; z-index: 4; width: 52px; height: 52px; margin-top: -26px; border-radius: 50%; border: 0; background: #111; color: #fff; font-size: 22px; cursor: pointer; opacity: 0; pointer-events: none; }
