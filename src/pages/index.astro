---
// Home page — content from "NorLha_Website_Content and Concept.docx", PAGE 1 — HOME (trimmed to a minimal selection).
// Layout: hero → centred intro + photo carousel → journeys mosaic → travel-styles brochure →
// NorLha Way (photos beside principles) → illustrated destinations map → the NorLha Promise.
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Photo from '../components/Photo.astro';
import { site } from '../data/site.js';
import { journeys } from '../data/journeys.js';
import { styles } from '../data/styles.js';
import { destinations } from '../data/destinations.js';
import { bhutanDistricts } from '../data/bhutan-map.js';

// Hero slideshow — photos crossfade in this order (names are files in src/assets/photos)
const heroSlides = [
  { photo: 'hero-himalaya', alt: 'Sunrise over prayer flags on a Bhutanese mountain ridge', tone: 'dawn' },
  { photo: 'tigers-nest', alt: 'Tiger’s Nest Monastery on its cliff above Paro Valley', tone: 'forest' },
  { photo: 'punakha-dzong', alt: 'Punakha Dzong at the meeting of two rivers', tone: 'valley' },
  { photo: 'dochula', alt: 'Chortens on Dochula Pass', tone: 'snow' },
  { photo: 'phobjikha', alt: 'The Phobjikha valley', tone: 'forest' },
];

// THE NORLHA WAY — five principles, one line each (sentences from the original copy)
const pillars = [
  { t: 'Personally curated', line: 'We shape the journey around you.' },
  { t: 'Privately experienced', line: 'The freedom to experience Bhutan without being tied to someone else’s schedule.' },
  { t: 'Thoughtfully selected', line: 'Where you stay and how you travel are part of the experience.' },
  { t: 'Locally connected', line: 'Bhutan is best experienced through its people.' },
  { t: 'Seamlessly arranged', line: 'The best journeys feel effortless.' },
];

// YOUR BHUTAN, PERSONALLY CURATED — six experiences, as listed on the home page
const experiences = [
  { t: 'Luxury Bhutan', p: 'Comfort, privacy and exceptional experiences, thoughtfully combined.', href: '/explore/luxury-bhutan/', photo: 'luxury', tone: 'dusk' },
  { t: 'Cultural Journeys', p: 'Discover Bhutan’s history, spirituality, architecture, traditions and people.', href: '/explore/cultural-bhutan/', photo: 'culture', tone: 'dzong' },
  { t: 'Himalayan Adventures', p: 'Experience Bhutan’s mountains, forests, valleys and trails.', href: '/explore/himalayan-adventures/', photo: 'trek', tone: 'snow' },
  { t: 'Romance & Honeymoons', p: 'Private journeys designed around two people and their story.', href: '/explore/romance-and-honeymoons/', photo: 'romance', tone: 'dawn' },
  { t: 'Family Journeys', p: 'Meaningful experiences designed for every generation.', href: '/explore/family-journeys/', photo: 'family', tone: 'valley' },
  // Not a travel style in styles.js, so its brochure page carries its own tags and headline (from the Tailor-Made page)
  { t: 'Tailor-Made Bhutan', p: 'No template. No fixed formula. Simply your journey.', href: '/tailor-made/', photo: 'tailor-hero', tone: 'forest', tags: 'Private · Bespoke', headline: 'Don’t choose a package. Create a journey.' },
];

// Bhutan Journeys mosaic — the signature journey takes the large tile, the rest follow in order
const journeyTiles = [...journeys.filter((j) => j.signature), ...journeys.filter((j) => !j.signature)];

// Small line icons for the social links in the Promise section
const socialIcon: Record<string, string> = {
  Facebook: '<path d="M14 8h2.5V4.5H14c-2.2 0-4 1.8-4 4V11H8v3.5h2V21h3.5v-6.5H16l.5-3.5h-3V8.8c0-.4.3-.8.5-.8z" />',
  Instagram: '<rect x="4" y="4" width="16" height="16" rx="4.5" /><circle cx="12" cy="12" r="3.8" /><circle cx="17" cy="7" r="0.9" class="dot" />',
  YouTube: '<rect x="3" y="6" width="18" height="12" rx="3.5" /><path d="M10.5 9.6v4.8l4-2.4z" class="dot" />',
};

// Only show social icons that have a real address (placeholders are '#' in site.js)
const liveSocial = site.social.filter((sn) => sn.href && sn.href !== '#');

// Photo carousel in the introduction — alternating tall / short frames
const gallery = [
  { photo: 'punakha-dzong', alt: 'Punakha Dzong at the meeting of two rivers', tone: 'valley' },
  { photo: 'paro-valley', alt: 'The Paro valley', tone: 'dawn' },
  { photo: 'prayer-flags', alt: 'Prayer flags on a suspension bridge', tone: 'dawn' },
  { photo: 'trongsa', alt: 'Trongsa Dzong above the valley', tone: 'dzong' },
  { photo: 'culture-2', alt: 'Bhutanese cultural life', tone: 'dzong' },
  { photo: 'phobjikha', alt: 'Black-necked cranes over Phobjikha', tone: 'forest' },
  { photo: 'trek-2', alt: 'A Himalayan trail', tone: 'snow' },
  { photo: 'thimphu', alt: 'Thimphu valley', tone: 'valley' },
  { photo: 'wellness-2', alt: 'A quiet moment in Bhutan', tone: 'dusk' },
  { photo: 'eastern-bhutan', alt: 'The hills of eastern Bhutan', tone: 'forest' },
];

// Brochure pages — each experience, enriched with its travel-style tags, headline and summary
const brochure = experiences.map((e) => {
  const st = styles.find((x) => e.href === `/explore/${x.slug}/`);
  return { title: e.t, href: e.href, photo: e.photo, tone: e.tone, tags: st?.tags ?? e.tags, headline: st?.headline ?? e.headline, text: st?.summary ?? e.p };
});

// DESTINATIONS MAP — soft stylised Bhutan, real town positions, one dashed journey line,
// round photo markers set just off the route (connected by a fine leader line).
// Coordinates are [longitude, latitude]; the outline is simplified and illustrative.
const W = 1000, H = 556;
const proj = ([lon, lat]: number[]) => [((lon - 88.7) / 3.45) * W, ((28.35 - lat) / 1.7) * H];
const f = (n: number) => n.toFixed(1);
// Smooth curve through points (Catmull-Rom → cubic Bézier)
const smooth = (pts: number[][], closed = false) => {
  const n = pts.length;
  const at = (i: number) => (closed ? pts[(i + n) % n] : pts[Math.max(0, Math.min(n - 1, i))]);
  let d = `M${f(pts[0][0])},${f(pts[0][1])}`;
  for (let i = 0; i < (closed ? n : n - 1); i++) {
    const p0 = at(i - 1), p1 = at(i), p2 = at(i + 1), p3 = at(i + 2);
    d += ` C${f(p1[0] + (p2[0] - p0[0]) / 6)},${f(p1[1] + (p2[1] - p0[1]) / 6)} ${f(p2[0] - (p3[0] - p1[0]) / 6)},${f(p2[1] - (p3[1] - p1[1]) / 6)} ${f(p2[0])},${f(p2[1])}`;
  }
  return closed ? d + ' Z' : d;
};
const placeLL: Record<string, number[]> = {
  haa: [89.28, 27.37], paro: [89.41, 27.43], thimphu: [89.64, 27.47], punakha: [89.86, 27.59], phobjikha: [90.18, 27.46],
  trongsa: [90.51, 27.5], bumthang: [90.75, 27.55], 'eastern-bhutan': [91.55, 27.33],
};
// Where each round photo marker sits relative to its town (map units) and which side its name goes
const callout: Record<string, { dx: number; dy: number; side: 'left' | 'right' }> = {
  haa: { dx: -70, dy: 100, side: 'left' }, paro: { dx: -70, dy: -95, side: 'left' }, thimphu: { dx: 30, dy: 125, side: 'left' },
  punakha: { dx: -20, dy: -115, side: 'left' }, phobjikha: { dx: 60, dy: 110, side: 'right' }, trongsa: { dx: -30, dy: -120, side: 'right' },
  bumthang: { dx: 90, dy: -100, side: 'right' }, 'eastern-bhutan': { dx: 0, dy: -95, side: 'right' },
};
// A destination without coordinates is left off the map (with a build warning) instead of breaking the build;
// one without a callout gets a default marker position above its town.
const pins = destinations.flatMap((d) => {
  if (!placeLL[d.id]) {
    console.warn(`[home map] No coordinates for destination "${d.id}" — add it to placeLL in src/pages/index.astro`);
    return [];
  }
  const [x, y] = proj(placeLL[d.id]);
  const c = callout[d.id] ?? { dx: 0, dy: -100, side: 'right' as const };
  return [{ ...d, x, y, cx: x + c.dx, cy: y + c.dy, side: c.side }];
});
const pinById = Object.fromEntries(pins.map((p) => [p.id, p]));
// One journey line through the kingdom, west to east (skipping any stop that isn't on the map)
const chain = ['haa', 'paro', 'thimphu', 'punakha', 'phobjikha', 'trongsa', 'bumthang', 'eastern-bhutan'].filter((id) => pinById[id]);
const chainPts = chain.map((id) => [pinById[id].x, pinById[id].y]);
const journeyLine = smooth(chainPts);
// Approximate driving times — adjust freely.
const notes: Record<string, string> = {
  'haa|paro': 'via Chele La · approx. 2.5 hrs', 'paro|thimphu': 'approx. 1 hr', 'punakha|thimphu': 'via Dochula Pass · approx. 2.5 hrs',
  'phobjikha|punakha': 'approx. 3 hrs', 'phobjikha|trongsa': 'via Pele La · approx. 3 hrs', 'bumthang|trongsa': 'via Yotong La · approx. 2.5 hrs',
  'bumthang|eastern-bhutan': 'via Thrumshing La · a full day',
};
const routes = chain.slice(0, -1).map((a, i) => {
  const b = chain[i + 1];
  const seg = smooth([chainPts[Math.max(0, i - 1)], chainPts[i], chainPts[i + 1], chainPts[Math.min(chain.length - 1, i + 2)]]);
  // keep only the middle piece of the 4-point curve (the stretch between a and b) — identical to that stretch of the full line
  const parts = seg.split(' C');
  const d = `M${f(chainPts[i][0])},${f(chainPts[i][1])} C${parts[2]}`;
  const A = pinById[a], B = pinById[b];
  return { a, b, d, note: notes[[a, b].sort().join('|')], label: `${A.name} – ${B.name}`, lx: (A.x + B.x) / 2, ly: (A.y + B.y) / 2 + 26 };
});
---

<Base>
  <!-- 1. Opening -->
  <Hero size="full" photo="hero-himalaya" alt="Sunrise over prayer flags on a Bhutanese mountain ridge" tone="dawn" title="NorLha" tagline="Bhutan, your way." slides={heroSlides} />

  <!-- 2. Introduction — centred heading and copy, then a photo carousel -->
  <section class="intro" id="start">
    <div class="wrap">
      <div class="intro-inner reveal">
        <span class="eyebrow">Your journey. Your pace. Your Bhutan.</span>
        <h2 class="h2 intro-title">Private journeys, thoughtfully curated around you.</h2>
        <div class="intro-copy">
          <p>Some journeys are about seeing as much as possible. Others are about experiencing a place deeply.</p>
          <p>At NorLha, we believe Bhutan belongs in the second category.</p>
          <p>We create private journeys that bring together Bhutan’s extraordinary landscapes, living traditions, spiritual heritage, warm hospitality, and remarkable places to stay—at a pace that feels right for you.</p>
          <p>From the first conversation to the moment you leave Bhutan, every detail is thoughtfully considered.</p>
        </div>
        <a href="/about/" class="link intro-btn">About NorLha</a>
      </div>
    </div>

    <!-- Photo carousel: alternating tall / short frames, bleeding off both edges -->
    <div class="carousel reveal" data-carousel>
      <div class="c-track" data-track tabindex="0" aria-label="Photographs of Bhutan — scroll sideways">
        {gallery.map((g, i) => (
          <figure class:list={['c-item', i % 2 === 0 ? 'tall' : 'short']}>
            <Photo name={g.photo} alt={g.alt} tone={g.tone as any} sizes="(max-width: 760px) 70vw, 400px" />
          </figure>
        ))}
      </div>
      <button type="button" class="c-btn c-prev" data-prev aria-label="Previous photographs">‹</button>
      <button type="button" class="c-btn c-next" data-next aria-label="Next photographs">›</button>
      <span class="c-cursor" aria-hidden="true" data-cursor><i>‹</i><i>›</i></span>
    </div>
  </section>

  <!-- 3. Bhutan Journeys — mosaic: one tall tile + 2×2 -->
  <section class="section bg-2 jr">
    <div class="wrap">
      <div class="jr-head reveal">
        <div>
          <span class="eyebrow">Bhutan Journeys</span>
          <h2 class="h2">Discover Bhutan, your way.</h2>
        </div>
        <a href="/journeys/" class="link">View all journeys</a>
      </div>
      <div class="jr-grid">
        {journeyTiles.map((j, i) => (
          <a href={`/journeys/${j.slug}/`} class:list={['jr-tile reveal', { 'jr-big': i === 0 }]} style={`transition-delay:${i * 80}ms`}>
            <Photo name={j.photo} alt={`${j.title} — ${j.route.join(', ')}`} tone={j.tone} sizes={i === 0 ? '(max-width: 860px) 100vw, 40vw' : '(max-width: 860px) 100vw, 30vw'} />
            <span class="jr-shade" aria-hidden="true"></span>
            <span class="jr-body">
              <span class="jr-label">{j.days} days · {j.nights} nights{j.signature ? ' · Signature' : ''}</span>
              <span class="jr-title">{j.title}</span>
              <span class="jr-meta"><span>{[...new Set(j.route)].join(' · ')}</span><span class="jr-arrow" aria-hidden="true">→</span></span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. Your Bhutan, personally curated — coverflow: the chosen style in front, the others fanning out smaller behind it -->
  <section class="section bro" data-cf>
    <div class="wrap">
      <div class="head center reveal">
        <span class="eyebrow">Explore Bhutan your way</span>
        <h2 class="h2">Your Bhutan, personally curated.</h2>
      </div>
    </div>

    <div class="cf-wrap reveal">
    <div class="cf" aria-roledescription="carousel" aria-label="Travel styles">
      <ul class="cf-track" data-track>
        {brochure.map((b, i) => (
          <li class="cf-card" data-card aria-label={`${i + 1} of ${brochure.length}: ${b.title}`}>
            <Photo name={b.photo} alt="" tone={b.tone as any} sizes="(max-width: 760px) 74vw, 340px" />
            <span class="cf-shade" aria-hidden="true"></span>
            <div class="cf-body on-dark">
              {b.tags && <span class="cf-label">{b.tags}</span>}
              <h3 class="cf-title">{b.title}</h3>
              <div class="cf-more">
                <div class="cf-more-in">
                  <p class="cf-text">{b.headline ? `${b.headline} ` : ''}{b.text}</p>
                  <a href={b.href} class="link" data-explore>Explore</a>
                </div>
              </div>
            </div>
          </li>
        ))}
      </ul>
    </div>
      <!-- arrows sit outside the masked strip so the edge fade doesn't dim them -->
      <button type="button" class="cf-arrow cf-prev" data-prev aria-label="Previous travel style">←</button>
      <button type="button" class="cf-arrow cf-next" data-next aria-label="Next travel style">→</button>
    </div>

    <div class="cf-cta">
      <a href="/tailor-made/#enquire" class="cf-cta-btn">Customize your journey</a>
    </div>
  </section>

  <!-- 5. The NorLha Way — portrait photo beside a hairline list -->
  <section class="section bg-2">
    <div class="wrap way">
      <div class="way-photos">
        <Photo name="way-curated" alt="A quiet moment in a Bhutanese valley" tone="valley" class="wp-big reveal" sizes="(max-width: 860px) 100vw, 40vw" />
        <Photo name="tigers-nest" alt="Tiger’s Nest Monastery on its cliff above Paro Valley" tone="forest" class="wp-small reveal" sizes="(max-width: 860px) 60vw, 22vw" />
      </div>
      <div class="way-text reveal">
        <span class="eyebrow">The NorLha Way</span>
        <h2 class="h2">Travel slowly. <em>Discover deeply.</em></h2>
        <p>Bhutan rewards those who take their time.</p>
        <ul class="way-list">
          {pillars.map((x) => (
            <li><span class="w-t">{x.t}</span><span class="w-l">{x.line}</span></li>
          ))}
        </ul>
        <a href="/the-norlha-way/" class="link">Read more</a>
      </div>
    </div>
  </section>

  <!-- 6. Destinations — soft illustrated map with photo markers -->
  <section class="section dmap" data-map>
    <div class="wrap">
      <div class="head center reveal">
        <span class="eyebrow">Destinations</span>
        <h2 class="h2">Bhutan, beyond the expected.</h2>
        <p class="lede">From the cultural heart of Paro and Thimphu to the peaceful valleys of Punakha, Phobjikha and Bumthang, every part of Bhutan offers something different.</p>
        <a href="/destinations/" class="link dm-more">Learn more</a>
      </div>

        <div class="dm-map reveal">
          <svg viewBox={`0 0 ${W} ${H}`} role="group" aria-label="Illustrated map of Bhutan with NorLha destinations">
            <g class="dm-land">
              {bhutanDistricts.map((d) => <path d={d.d}><title>{d.name}</title></path>)}
            </g>
            <text class="dm-country" x="660" y="440" text-anchor="middle">Bhutan</text>

            <path class="dm-journey" d={journeyLine} />

            {routes.map((r) => (
              <g class="dm-route" data-a={r.a} data-b={r.b} tabindex="0" role="button" aria-label={`${r.label}, ${r.note}`}>
                <path class="dm-hit" d={r.d} />
                <path class="dm-line" d={r.d} />
                <text class="dm-note" x={r.lx} y={r.ly} text-anchor="middle">{r.note}</text>
              </g>
            ))}

            {pins.map((p) => (
              <g class="dm-town" data-town={p.id}>
                <line class="dm-leader" x1={p.x} y1={p.y} x2={p.cx} y2={p.cy} />
                <circle class="dm-dot" cx={p.x} cy={p.y} r="4" />
              </g>
            ))}
          </svg>

          {pins.map((p) => (
            <a href={`/destinations/#${p.id}`} class:list={['dm-marker', `side-${p.side}`]} data-id={p.id}
              style={`left:${((p.cx / W) * 100).toFixed(2)}%;top:${((p.cy / H) * 100).toFixed(2)}%`} aria-label={`${p.name} — open on the Destinations page`}>
              <span class="dm-circle"><Photo name={p.photo} alt="" tone={p.tone as any} sizes="120px" /></span>
              <span class="dm-name">{p.name}</span>
            </a>
          ))}
          <small class="dm-credit">Map data © <a href="https://www.geoboundaries.org" rel="noopener" target="_blank">geoBoundaries</a> (CC BY 4.0)</small>
        </div>
        <!-- phones: the map is too small for town names, so list them underneath -->
        <ul class="dm-list">
          {pins.map((p) => (
            <li><a href={`/destinations/#${p.id}`}>{p.name}</a></li>
          ))}
        </ul>
    </div>
  </section>

  <!-- 7. The NorLha Promise — simple: heading, two lines, social icons -->
  <section class="promise">
    <div class="wrap-narrow pr-inner reveal">
      <h2 class="pr-title">We take care of the details.</h2>
      <p class="pr-text">We listen carefully. We plan thoughtfully. We remain flexible.<br />Our role is simple: to make your journey feel effortless, personal and deeply memorable.</p>
      <a href="/tailor-made/#enquire" class="link pr-cta">Customize your journey</a>
      {liveSocial.length > 0 && (
        <ul class="pr-social">
          {liveSocial.map((sn) => (
            <li><a href={sn.href} rel="noopener" target="_blank" aria-label={`NorLha on ${sn.label}`}><svg viewBox="0 0 24 24" aria-hidden="true" set:html={socialIcon[sn.label] ?? ''} /></a></li>
          ))}
        </ul>
      )}
    </div>
  </section>
</Base>

<script>

  // Travel styles coverflow: arrows, ← → keys, swipe, or click a side card to bring it to the front
  const cfRoot = document.querySelector<HTMLElement>('[data-cf]');
  if (cfRoot) {
    const cards = [...cfRoot.querySelectorAll<HTMLElement>('[data-card]')];
    const n = cards.length;
    const X = [0, 0.74, 1.34, 1.8]; // horizontal offset per step, in card widths
    let cur = 0;
    const layout = () => {
      cards.forEach((c, k) => {
        const d = ((k - cur + n + Math.floor(n / 2)) % n) - Math.floor(n / 2); // -3..2 for six cards
        const a = Math.abs(d);
        c.style.setProperty('--x', String(Math.sign(d) * X[Math.min(a, 3)]));
        c.style.setProperty('--s', String(1 - a * 0.12));
        c.style.zIndex = String(10 - a);
        c.dataset.d = String(Math.min(a, 3));
        c.setAttribute('aria-hidden', d === 0 ? 'false' : 'true');
        c.querySelector('[data-explore]')!.setAttribute('tabindex', d === 0 ? '0' : '-1');
      });
    };
    const go = (to: number) => { cur = (to + n) % n; layout(); };
    cfRoot.querySelector('[data-prev]')!.addEventListener('click', () => go(cur - 1));
    cfRoot.querySelector('[data-next]')!.addEventListener('click', () => go(cur + 1));
    cards.forEach((c, k) => c.addEventListener('click', (e) => {
      if (k !== cur) { e.preventDefault(); go(k); }
    }));
    cfRoot.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); go(cur + 1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); go(cur - 1); }
    });
    const track = cfRoot.querySelector<HTMLElement>('[data-track]')!;
    let sx: number | null = null;
    track.addEventListener('pointerdown', (e) => { sx = e.pointerType === 'mouse' ? null : e.clientX; });
    track.addEventListener('pointercancel', () => { sx = null; });
    track.addEventListener('pointerup', (e) => {
      if (sx === null) return;
      const dx = e.clientX - sx;
      sx = null;
      if (Math.abs(dx) > 40) go(cur + (dx < 0 ? 1 : -1));
    });
    layout();
  }

  // Destinations map: hovering a place or a stretch of route lights it up; markers link to the Destinations page
  const dmap = document.querySelector<HTMLElement>('[data-map]');
  if (dmap) {
    const markers = [...dmap.querySelectorAll<HTMLElement>('.dm-marker')];
    const towns = [...dmap.querySelectorAll<SVGGElement>('.dm-town')];
    const routesEl = [...dmap.querySelectorAll<SVGGElement>('.dm-route')];
    const light = (ids: string[]) => {
      markers.forEach((m) => m.classList.toggle('on', ids.includes(m.dataset.id!)));
      towns.forEach((t) => t.classList.toggle('on', ids.includes(t.dataset.town!)));
    };
    const select = (id: string) => {
      light([id]);
      routesEl.forEach((r) => { r.classList.toggle('on', r.dataset.a === id || r.dataset.b === id); r.classList.toggle('picked', false); });
    };
    const selectRoute = (r: SVGGElement) => {
      routesEl.forEach((x) => { x.classList.toggle('on', x === r); x.classList.toggle('picked', x === r); });
      light([r.dataset.a!, r.dataset.b!]);
    };
    markers.forEach((m) => {
      m.addEventListener('mouseenter', () => select(m.dataset.id!));
      m.addEventListener('focus', () => select(m.dataset.id!));
    });
    routesEl.forEach((r) => {
      r.addEventListener('click', () => selectRoute(r));
      r.addEventListener('mouseenter', () => selectRoute(r));
      r.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); selectRoute(r); }
      });
    });
    select('thimphu');
  }

  // Intro photo carousel: click left/right half or drag (mouse), swipe (touch), buttons (keyboard)
  const car = document.querySelector<HTMLElement>('[data-carousel]');
  if (car) {
    const track = car.querySelector<HTMLElement>('[data-track]')!;
    const cursor = car.querySelector<HTMLElement>('[data-cursor]')!;
    const step = () => {
      const item = track.querySelector<HTMLElement>('.c-item');
      return item ? item.offsetWidth + parseFloat(getComputedStyle(track).columnGap || '0') : 400;
    };
    const go = (dir: number) => track.scrollBy({ left: dir * step(), behavior: 'smooth' });
    car.querySelector('[data-prev]')!.addEventListener('click', () => go(-1));
    car.querySelector('[data-next]')!.addEventListener('click', () => go(1));

    // start part-way in so frames bleed off both edges
    requestAnimationFrame(() => { track.scrollLeft = step() * 0.55; });

    let down = false, dragged = false, startX = 0, startLeft = 0;
    track.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse') return;
      down = true; dragged = false; startX = e.clientX; startLeft = track.scrollLeft;
      track.classList.add('dragging');
    });
    window.addEventListener('pointerup', () => { down = false; track.classList.remove('dragging'); });
    track.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse') return;
      const r = car.getBoundingClientRect();
      cursor.style.transform = `translate(${e.clientX - r.left}px, ${e.clientY - r.top}px)`;
      cursor.classList.toggle('left', e.clientX - r.left < r.width / 2);
      if (down) {
        const dx = e.clientX - startX;
        if (Math.abs(dx) > 5) dragged = true;
        track.scrollLeft = startLeft - dx;
      }
    });
    track.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') car.classList.add('hover'); });
    track.addEventListener('pointerleave', () => car.classList.remove('hover'));
    track.addEventListener('click', (e) => {
      if (dragged) { dragged = false; return; }
      const r = car.getBoundingClientRect();
      go(e.clientX - r.left < r.width / 2 ? -1 : 1);
    });
  }
</script>

<style>
  /* Intro — centred editorial composition */
