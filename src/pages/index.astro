  .cf-shade { position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgba(20, 16, 12, 0.18) 0%, rgba(20, 16, 12, 0) 30%, rgba(20, 16, 12, 0.15) 50%, rgba(20, 16, 12, 0.72) 100%); transition: background-color 0.6s var(--ease); }
  .cf-card:hover .cf-shade, .cf-card:focus-within .cf-shade { background-color: rgba(20, 16, 12, 0.28); }

