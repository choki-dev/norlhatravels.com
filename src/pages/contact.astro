---
// Contact — brief section 06 (contact information, enquiry form, location, social links);
// closing words from the Content & Concept doc ("Begin your journey").
// Title banner → contact details as icon columns → enquiry beside the form → map.
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import { site } from '../data/site.js';

// Placeholders in site.js stay hidden until they are filled in
const hasWhatsapp = !/^\+?975[\s0]*$/.test(site.whatsapp);
const liveSocial = site.social.filter((s) => s.href && s.href !== '#');
---

<Base title="Contact Us" description="Contact NorLha Tours & Travels to begin planning your private journey in Bhutan.">
  <Hero size="medium" photo="contact-hero" alt="Prayer flags above a mountain pass" tone="snow" eyebrow="Contact us" title="Let’s begin <em>a conversation.</em>" />

  <!-- Details -->
  <section class="section">
    <div class="wrap feats info">
      <div class="feat reveal">
        <Icon name="mail" size={48} />
        <h3>Write to us</h3>
        <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
      </div>
      <div class="feat reveal" style="transition-delay:80ms">
        <Icon name="phone" size={48} />
        <h3>Call{hasWhatsapp && ' or WhatsApp'}</h3>
        <p><a href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a></p>
        {hasWhatsapp && <p><a href={`https://wa.me/${site.whatsapp.replace(/\D/g, '')}`} rel="noopener">Message on WhatsApp →</a></p>}
      </div>
      <div class="feat reveal" style="transition-delay:160ms">
        <Icon name="pin" size={48} />
        <h3>Visit us</h3>
        <address>{site.address.join(', ')}</address>
      </div>
      <div class="feat reveal" style="transition-delay:240ms">
        <Icon name="clock" size={48} />
        <h3>Office hours</h3>
        <p>{site.hours}</p>
      </div>
    </div>
  </section>

  <!-- Enquiry -->
  <section class="section bg-2">
    <div class="wrap enq">
      <div class="reveal">
        <span class="kicker">Begin your journey</span>
        <h2 class="big c-title">Bhutan is waiting.</h2>
        <p>Tell us what you are looking for, and let us create a journey around it.</p>
        <p class="note">From the first conversation to the moment you leave Bhutan, every detail is thoughtfully considered.</p>
        {liveSocial.length > 0 && (
          <div class="social">
            <span class="kicker">Follow NorLha</span>
            <div>{liveSocial.map((s) => <a href={s.href} rel="noopener" target="_blank">{s.label}</a>)}</div>
          </div>
        )}
      </div>
      <div class="panel reveal"><EnquiryForm /></div>
    </div>
  </section>

  <section class="map">
    <iframe src={site.mapEmbed} title="NorLha office location" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
  </section>
</Base>

<style>
  .info { text-align: center; }
  .info .feat { align-items: center; padding: 10px 12px; }
  .info .feat + .feat { border-left: 1px solid var(--line); }
  .info .feat p { font-size: 16px; color: var(--ink); word-break: break-word; }
  .info .feat a:hover { color: var(--saffron); }
  address { font-style: normal; font-size: 16px; color: var(--ink); }
  @media (max-width: 960px) { .info .feat:nth-child(3) { border-left: 0; } }
  @media (max-width: 520px) { .info .feat + .feat { border-left: 0; border-top: 1px solid var(--line); padding-top: 40px; } }
  .c-title { margin: 16px 0 20px; }
  .social { margin-top: 36px; }
  .social div { display: flex; gap: 20px; margin-top: 10px; font-family: var(--serif); font-size: 20px; color: var(--heading); }
  .social a:hover { color: var(--saffron); }
  .map { height: 440px; background: var(--paper-2); }
  .map iframe { width: 100%; height: 100%; border: 0; filter: grayscale(0.7) sepia(0.12); }
</style>
