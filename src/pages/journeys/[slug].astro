---
// One journey — reads like a travel plan:
// hero → numbers band (days · nights · places) → the route as a line of stops with nights at each →
// overview + highlights → day-by-day accordion → optional extras & accommodation → enquiry → next journey.
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Photo from '../../components/Photo.astro';
import EnquiryForm from '../../components/EnquiryForm.astro';
import { journeys, accommodation } from '../../data/journeys.js';

export function getStaticPaths() {
  return journeys.map((j) => ({ params: { slug: j.slug }, props: { journey: j } }));
}

const { journey: j } = Astro.props;
const idx = journeys.findIndex((x) => x.slug === j.slug);
const next = journeys[(idx + 1) % journeys.length];
const stops = [...new Set(j.route as string[])];
---

<Base title={`${j.title} — ${j.days} Days / ${j.nights} Nights`} description={`${j.title}: a ${j.days}-day private journey through ${stops.join(', ')}. ${j.summary}`}>
  <Hero photo={j.photo} alt={`${j.title} — ${stops.join(', ')}`} tone={j.tone} eyebrow={`Private journey${j.signature ? ' · Signature' : ''}`} title={j.title} sub={j.summary}>
    <a href="#enquire" class="btn btn-solid">Enquire about this journey <span class="arrow">→</span></a>
  </Hero>

  <!-- Numbers -->
  <div class="numbers">
    <div class="wrap n-row">
      <div><b>{j.days}</b><span>Days</span></div>
      <div><b>{j.nights}</b><span>Nights</span></div>
      <div><b>{stops.length}</b><span>{stops.length === 1 ? 'Valley' : 'Places'}</span></div>
      <div><b>{j.highlights.length}</b><span>Highlights</span></div>
    </div>
  </div>

  <!-- The route -->
  <section class="route-sec">
    <div class="wrap">
      <div class="r-head reveal">
        <span class="eyebrow">The route</span>
        <p>{j.intro}</p>
      </div>
      <ol class="route reveal" style={`--n:${j.overnight.length}`}>
        {j.overnight.map((o: any, i: number) => (
          <li>
            <span class="r-dot" aria-hidden="true"></span>
            <span class="r-step">Stop {i + 1}</span>
            <span class="r-place">{o.place}</span>
            <span class="r-nights">{o.nights} {o.nights === 1 ? 'night' : 'nights'}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Highlights beside a photo -->
  <section class="hl bg-2">
    <div class="wrap hl-grid">
      <Photo name={j.photo} alt={j.title} tone={j.tone} class="hl-photo reveal" sizes="(max-width: 860px) 100vw, 45vw" />
      <div class="reveal">
        <span class="eyebrow">Highlights</span>
        <ol class="hl-list">
          {j.highlights.map((h: string, i: number) => <li><span>{String(i + 1).padStart(2, '0')}</span>{h}</li>)}
        </ol>
      </div>
    </div>
  </section>

  <!-- Day by day — accordion -->
  <section class="section">
    <div class="wrap days-wrap">
      <div class="d-head reveal">
        <span class="eyebrow">Day by day</span>
        <h2 class="h2">Your journey, <em>at your pace.</em></h2>
        <p>Itineraries are a starting point and may be adjusted for flight times, opening hours, festivals, weather and road conditions. Every element can be tailored to you.</p>
        <button type="button" class="d-all" data-all>Open all days</button>
      </div>
      <div class="days" data-days>
        {j.itinerary.map((d: any, i: number) => (
          <details class="day reveal" open={i === 0}>
            <summary>
              <span class="d-no">Day {String(i + 1).padStart(2, '0')}</span>
              <span class="d-title">{d.title}</span>
              <span class="d-icon" aria-hidden="true"></span>
            </summary>
            <ul class="d-body">{d.items.map((it: string) => <li>{it}</li>)}</ul>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Extras & accommodation -->
  <section class="extras bg-2">
    <div class="wrap x-grid">
      <div class="reveal">
        <span class="eyebrow">Optional experiences &amp; upgrades</span>
        <ul class="x-opt">{j.optional.map((o: string) => <li>{o}</li>)}</ul>
      </div>
      <div class="reveal">
        <span class="eyebrow">Accommodation, your way</span>
        <p class="x-note">Every journey can be arranged at the level of comfort you prefer. Upgrading your accommodation does not change the core route.</p>
        <dl class="x-tiers">
          {accommodation.map((a) => <div><dt>{a.tier}</dt><dd>{a.text}</dd></div>)}
        </dl>
      </div>
    </div>
  </section>

  <!-- Enquire -->
  <section class="section enq-sec">
    <div class="wrap enq">
      <div class="reveal">
        <span class="eyebrow">Enquire</span>
        <h2 class="h2" style="margin:14px 0 22px">Make {j.title} <em>your own.</em></h2>
        <p class="lede">Extend your stay, change the pace or upgrade your accommodation. We will reply personally with ideas and a tailored proposal.</p>
      </div>
      <div class="panel reveal"><EnquiryForm journey={j.title} /></div>
    </div>
  </section>

  <!-- Next journey -->
  <a href={`/journeys/${next.slug}/`} class="next on-dark">
    <Photo name={next.photo} alt="" tone={next.tone} sizes="100vw" />
    <span class="n-shade" aria-hidden="true"></span>
    <span class="wrap n-inner">
      <span class="eyebrow">Next journey · {next.days} days</span>
      <span class="n-title">{next.title} <span class="arrow" aria-hidden="true">→</span></span>
      <span class="n-route">{[...new Set(next.route)].join(' · ')}</span>
    </span>
  </a>
</Base>

<script>
  const all = document.querySelector<HTMLButtonElement>('[data-all]');
  const days = [...document.querySelectorAll<HTMLDetailsElement>('[data-days] details')];
  all?.addEventListener('click', () => {
    const open = !days.every((d) => d.open);
    days.forEach((d) => (d.open = open));
    all.textContent = open ? 'Close all days' : 'Open all days';
  });
</script>

<style>
  /* Numbers */
  .numbers { background: var(--paper); border-bottom: 1px solid var(--line); }
  .n-row { display: grid; grid-template-columns: repeat(4, 1fr); }
  .n-row div { display: flex; flex-direction: column; align-items: center; gap: 8px; padding: 36px 0; border-left: 1px solid var(--line); }
  .n-row div:first-child { border-left: 0; }
  .n-row b { font-family: var(--serif); font-weight: 400; font-size: clamp(36px, 3.4vw, 48px); line-height: 1; color: var(--heading); }
  .n-row span { font-family: var(--label); font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-mute); }
  @media (max-width: 760px) {
    .n-row { grid-template-columns: 1fr 1fr; }
    .n-row div { padding: 24px 0; }
    .n-row div:nth-child(3) { border-left: 0; }
    .n-row div:nth-child(n + 3) { border-top: 1px solid var(--line); }
  }

  /* Route */
  .route-sec { padding: clamp(80px, 9vw, 130px) 0; }
  .r-head { max-width: 760px; margin: 0 auto clamp(56px, 6vw, 84px); text-align: center; }
  .r-head p { margin: 16px auto 0; font-family: var(--serif); font-size: clamp(22px, 2vw, 28px); line-height: 1.45; color: var(--heading); max-width: 44ch; }
  .route { position: relative; display: grid; grid-template-columns: repeat(var(--n), 1fr); }
  .route::before { content: ''; position: absolute; left: 0; right: 0; top: 8px; border-top: 1px dashed #b9ab92; }
  .route li { position: relative; padding-top: 40px; padding-right: 16px; }
  .r-dot { position: absolute; top: 0; left: 0; width: 17px; height: 17px; border-radius: 50%; background: var(--paper); border: 1px solid var(--saffron); }
  .r-dot::after { content: ''; position: absolute; inset: 4px; border-radius: 50%; background: var(--saffron); }
  .r-step { display: block; font-family: var(--label); font-size: 11.5px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-mute); }
  .r-place { display: block; margin-top: 8px; font-family: var(--serif); font-size: clamp(28px, 2.8vw, 40px); line-height: 1.05; color: var(--heading); }
  .r-nights { display: block; margin-top: 6px; font-family: var(--serif); font-style: italic; font-size: 19px; color: var(--saffron); }
  @media (max-width: 760px) {
    .route { grid-template-columns: 1fr; padding-left: 36px; gap: 28px; }
    .route::before { left: 8px; right: auto; top: 0; bottom: 0; border-top: 0; border-left: 1px dashed #b9ab92; }
    .route li { padding-top: 0; }
    .r-dot { left: -36px; top: 4px; }
  }

  /* Highlights */
  .hl { padding: clamp(80px, 9vw, 130px) 0; }
  .hl-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 7vw, 110px); align-items: center; }
  .hl-grid :global(.hl-photo) { aspect-ratio: 4 / 5; }
  .hl-list { margin-top: 18px; }
  .hl-list li { display: flex; gap: 22px; align-items: baseline; padding: 20px 0; border-bottom: 1px solid var(--line); font-family: var(--serif); font-size: clamp(22px, 2vw, 28px); line-height: 1.25; color: var(--heading); }
  .hl-list span { font-family: var(--label); font-size: 12px; letter-spacing: 0.1em; color: var(--saffron); }
  @media (max-width: 860px) { .hl-grid { grid-template-columns: 1fr; } .hl-grid :global(.hl-photo) { aspect-ratio: 4 / 3; } }

  /* Day-by-day accordion */
  .days-wrap { display: grid; grid-template-columns: 1fr 1.6fr; gap: clamp(40px, 7vw, 110px); align-items: start; }
  .d-head { position: sticky; top: 130px; }
  .d-head h2 { margin: 14px 0 20px; }
  .d-head p { font-size: 15px; color: var(--ink-mute); }
  .d-all { margin-top: 18px; padding: 0; border: 0; background: none; font-family: var(--label); font-size: 13px; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; color: var(--saffron); cursor: pointer; border-bottom: 1px solid currentColor; }
  .days { border-top: 1px solid var(--ink); }
  .day { border-bottom: 1px solid var(--line); }
  .day summary { display: grid; grid-template-columns: 90px 1fr 24px; gap: 20px; align-items: center; padding: 26px 0; cursor: pointer; list-style: none; }
  .day summary::-webkit-details-marker { display: none; }
  .d-no { font-family: var(--label); font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--saffron); }
  .d-title { font-family: var(--serif); font-size: clamp(22px, 2vw, 28px); line-height: 1.2; color: var(--heading); transition: color 0.3s var(--ease); }
  .day summary:hover .d-title { color: var(--saffron); }
  .d-icon { position: relative; width: 18px; height: 18px; }
  .d-icon::before, .d-icon::after { content: ''; position: absolute; left: 0; right: 0; top: 50%; height: 1px; background: var(--ink); transition: transform 0.4s var(--ease); }
  .d-icon::after { transform: rotate(90deg); }
  .day[open] .d-icon::after { transform: rotate(0deg); }
  .d-body { padding: 0 0 30px 110px; }
  .d-body li { position: relative; padding: 6px 0 6px 22px; font-size: 16px; line-height: 1.6; }
  .d-body li::before { content: ''; position: absolute; left: 0; top: 18px; width: 10px; height: 1px; background: var(--saffron); }
  @media (max-width: 860px) {
    .days-wrap { grid-template-columns: 1fr; }
    .d-head { position: static; }
    .day summary { grid-template-columns: 1fr 24px; gap: 6px 14px; }
    .d-no { grid-column: 1 / -1; }
    .d-body { padding-left: 0; }
  }

  /* Extras */
  .extras { padding: clamp(80px, 9vw, 130px) 0; }
  .x-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 8vw, 120px); align-items: start; }
  .x-opt { margin-top: 22px; display: flex; flex-wrap: wrap; gap: 10px; }
  .x-opt li { padding: 12px 20px; border: 1px solid #d9d0bf; border-radius: 999px; background: #fff; font-size: 15px; color: var(--ink); }
  .x-note { margin: 18px 0 8px; }
  .x-tiers div { display: grid; grid-template-columns: 120px 1fr; gap: 20px; padding: 16px 0; border-bottom: 1px solid var(--line); }
  .x-tiers dt { font-family: var(--serif); font-size: 22px; color: var(--heading); }
  .x-tiers dd { margin: 0; font-size: 15px; line-height: 1.6; }
  @media (max-width: 860px) { .x-grid { grid-template-columns: 1fr; } }

  /* Next journey */
  .next { position: relative; display: flex; align-items: center; min-height: 52svh; color: #fff; overflow: hidden; isolation: isolate; }
  .next :global(.photo) { position: absolute; inset: 0; z-index: -2; transition: transform 1.8s var(--ease); }
  .next:hover :global(.photo) { transform: scale(1.04); }
  .n-shade { position: absolute; inset: 0; z-index: -1; background: rgba(18, 14, 10, 0.5); transition: background 0.6s var(--ease); }
  .next:hover .n-shade { background: rgba(18, 14, 10, 0.38); }
  .n-inner { display: flex; flex-direction: column; gap: 14px; padding-top: 60px; padding-bottom: 60px; }
  .next .eyebrow { color: var(--saffron-soft); letter-spacing: 0.2em; }
  .n-title { font-family: var(--serif); font-size: clamp(40px, 6vw, 88px); line-height: 1; }
  .n-title .arrow { display: inline-block; font-size: 0.6em; transition: transform 0.5s var(--ease); }
  .next:hover .n-title .arrow { transform: translateX(14px); }
  .n-route { font-size: 15px; color: rgba(255, 255, 255, 0.8); }
</style>
