---
// Minimal centred footer: logo, one row of links, contact line, social icons, fine print.
import Logo from './Logo.astro';
import { site, nav } from '../data/site.js';
const year = new Date().getFullYear();
const links = [
  { label: 'Home', href: '/' },
  ...nav,
  { label: 'Tailor-Made', href: '/tailor-made/' },
  { label: 'Contact', href: '/contact/' },
];
const icon: Record<string, string> = {
  Facebook: '<path d="M14 8h2.5V4.5H14c-2.2 0-4 1.8-4 4V11H8v3.5h2V21h3.5v-6.5H16l.5-3.5h-3V8.8c0-.4.3-.8.5-.8z" />',
  Instagram: '<rect x="4" y="4" width="16" height="16" rx="4.5" /><circle cx="12" cy="12" r="3.8" /><circle cx="17" cy="7" r="0.9" class="dot" />',
  YouTube: '<rect x="3" y="6" width="18" height="12" rx="3.5" /><path d="M10.5 9.6v4.8l4-2.4z" class="dot" />',
};
---

<footer class="footer">
  <div class="wrap inner">
    <a href="/" class="brand" aria-label="NorLha — home"><Logo size={84} /></a>

    <nav aria-label="Footer">
      <ul class="links">
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>

    <p class="contact">
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <span aria-hidden="true">·</span>
      <a href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a>
    </p>
    <p class="addr">{site.address.slice(1).join(', ')}</p>

    <ul class="social">
      {site.social.map((s) => (
        <li><a href={s.href} rel="noopener" aria-label={`NorLha on ${s.label}`}><svg viewBox="0 0 24 24" aria-hidden="true" set:html={icon[s.label] ?? ''} /></a></li>
      ))}
    </ul>
  </div>

  <div class="wrap fine">
    <span>© {year} {site.legalName}</span>
    <span>Website Designed and Developed by <a href="https://abit.bt" rel="noopener" target="_blank">aBit Private Limited</a></span>
  </div>
</footer>

<style>
  .footer { background: var(--paper-2); padding: clamp(64px, 7vw, 96px) 0 0; color: var(--ink-soft); text-align: center; }
  .inner { display: flex; flex-direction: column; align-items: center; }

  .links { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px 28px; margin-top: 36px; }
  .links a { font-family: var(--label); font-size: 13px; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink); transition: color 0.3s var(--ease); }
  .links a:hover { color: var(--saffron); }

  .contact { margin: 34px 0 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 6px 14px; font-size: 15px; }
  .contact a { color: var(--ink); transition: color 0.3s var(--ease); }
  .contact a:hover { color: var(--saffron); }
  .contact span { color: var(--ink-mute); }
  .addr { margin: 6px 0 0; font-size: 14px; color: var(--ink-mute); }

  .social { display: flex; gap: 26px; margin-top: 26px; }
  .social a { display: grid; place-items: center; width: 36px; height: 36px; color: #a9a49b; transition: color 0.3s var(--ease); }
  .social a:hover { color: var(--saffron); }
  .social svg { width: 24px; height: 24px; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linejoin: round; }
  .social svg :global(.dot) { fill: currentColor; stroke: none; }

  .fine { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px 20px; margin-top: clamp(52px, 6vw, 72px); padding-top: 22px; padding-bottom: 26px; border-top: 1px solid var(--line); font-size: 12.5px; color: var(--ink-mute); }
  .fine a { text-decoration: underline; text-underline-offset: 2px; }
  .fine a:hover { color: var(--saffron); }
  /* phones: centre the fine print and leave room so the floating back-to-top button doesn't cover it */
  @media (max-width: 560px) { .fine { justify-content: center; text-align: center; padding-bottom: 84px; } }
</style>
