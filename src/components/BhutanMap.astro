---
// Soft illustrated map of Bhutan: real town positions, one dashed journey line west to east,
// round photo markers just off the route. Hovering a place or a stretch of route lights it up.
// Used on the home page and the Destinations page. `href(id)` builds each marker link.
import Photo from './Photo.astro';
import { destinations } from '../data/destinations.js';
import { bhutanDistricts } from '../data/bhutan-map.js';
interface Props { linkBase?: string }
const { linkBase = '/destinations/' } = Astro.props;

// DESTINATIONS MAP — soft stylised Bhutan, real town positions, one dashed journey line,
// round photo markers set just off the route (connected by a fine leader line).
// Coordinates are [longitude, latitude]; the outline is simplified and illustrative.
const W = 1000, H = 556;
const proj = ([lon, lat]: number[]) => [((lon - 88.7) / 3.45) * W, ((28.35 - lat) / 1.7) * H];
const f = (n: number) => n.toFixed(1);
// Smooth curve through points (Catmull-Rom → cubic Bézier)
const smooth = (pts: number[][], closed = false) => {
  const n = pts.length;
  const at = (i: number) => (closed ? pts[(i + n) % n] : pts[Math.max(0, Math.min(n - 1, i))]);
  let d = `M${f(pts[0][0])},${f(pts[0][1])}`;
  for (let i = 0; i < (closed ? n : n - 1); i++) {
    const p0 = at(i - 1), p1 = at(i), p2 = at(i + 1), p3 = at(i + 2);
    d += ` C${f(p1[0] + (p2[0] - p0[0]) / 6)},${f(p1[1] + (p2[1] - p0[1]) / 6)} ${f(p2[0] - (p3[0] - p1[0]) / 6)},${f(p2[1] - (p3[1] - p1[1]) / 6)} ${f(p2[0])},${f(p2[1])}`;
  }
  return closed ? d + ' Z' : d;
};
const placeLL: Record<string, number[]> = {
  haa: [89.28, 27.37], paro: [89.41, 27.43], thimphu: [89.64, 27.47], punakha: [89.86, 27.59], phobjikha: [90.18, 27.46],
  trongsa: [90.51, 27.5], bumthang: [90.75, 27.55], 'eastern-bhutan': [91.55, 27.33],
};
// Where each round photo marker sits relative to its town (map units) and which side its name goes
const callout: Record<string, { dx: number; dy: number; side: 'left' | 'right' }> = {
  haa: { dx: -70, dy: 100, side: 'left' }, paro: { dx: -70, dy: -95, side: 'left' }, thimphu: { dx: 30, dy: 125, side: 'left' },
  punakha: { dx: -20, dy: -115, side: 'left' }, phobjikha: { dx: 60, dy: 110, side: 'right' }, trongsa: { dx: -30, dy: -120, side: 'right' },
  bumthang: { dx: 90, dy: -100, side: 'right' }, 'eastern-bhutan': { dx: 0, dy: -95, side: 'right' },
};
// A destination without coordinates is left off the map (with a build warning) instead of breaking the build;
// one without a callout gets a default marker position above its town.
const pins = destinations.flatMap((d) => {
  if (!placeLL[d.id]) {
    console.warn(`[BhutanMap] No coordinates for destination "${d.id}" — add it to placeLL in src/components/BhutanMap.astro`);
    return [];
  }
  const [x, y] = proj(placeLL[d.id]);
  const c = callout[d.id] ?? { dx: 0, dy: -100, side: 'right' as const };
  return [{ ...d, x, y, cx: x + c.dx, cy: y + c.dy, side: c.side }];
});
const pinById = Object.fromEntries(pins.map((p) => [p.id, p]));
// One journey line through the kingdom, west to east (skipping any stop that isn't on the map)
const chain = ['haa', 'paro', 'thimphu', 'punakha', 'phobjikha', 'trongsa', 'bumthang', 'eastern-bhutan'].filter((id) => pinById[id]);
const chainPts = chain.map((id) => [pinById[id].x, pinById[id].y]);
const journeyLine = smooth(chainPts);
// Approximate driving times — adjust freely.
const notes: Record<string, string> = {
  'haa|paro': 'via Chele La · approx. 2.5 hrs', 'paro|thimphu': 'approx. 1 hr', 'punakha|thimphu': 'via Dochula Pass · approx. 2.5 hrs',
  'phobjikha|punakha': 'approx. 3 hrs', 'phobjikha|trongsa': 'via Pele La · approx. 3 hrs', 'bumthang|trongsa': 'via Yotong La · approx. 2.5 hrs',
  'bumthang|eastern-bhutan': 'via Thrumshing La · a full day',
};
const routes = chain.slice(0, -1).map((a, i) => {
  const b = chain[i + 1];
  const seg = smooth([chainPts[Math.max(0, i - 1)], chainPts[i], chainPts[i + 1], chainPts[Math.min(chain.length - 1, i + 2)]]);
  // keep only the middle piece of the 4-point curve (the stretch between a and b) — identical to that stretch of the full line
  const parts = seg.split(' C');
  const d = `M${f(chainPts[i][0])},${f(chainPts[i][1])} C${parts[2]}`;
  const A = pinById[a], B = pinById[b];
  return { a, b, d, note: notes[[a, b].sort().join('|')], label: `${A.name} – ${B.name}`, lx: (A.x + B.x) / 2, ly: (A.y + B.y) / 2 + 26 };
});
---

<div class="bmap" data-map>
        <div class="dm-map reveal">
          <svg viewBox={`0 0 ${W} ${H}`} role="group" aria-label="Illustrated map of Bhutan with NorLha destinations">
            <g class="dm-land">
              {bhutanDistricts.map((d) => <path d={d.d}><title>{d.name}</title></path>)}
            </g>
            <text class="dm-country" x="660" y="440" text-anchor="middle">Bhutan</text>

            <path class="dm-journey" d={journeyLine} />

            {routes.map((r) => (
              <g class="dm-route" data-a={r.a} data-b={r.b} tabindex="0" role="button" aria-label={`${r.label}, ${r.note}`}>
                <path class="dm-hit" d={r.d} />
                <path class="dm-line" d={r.d} />
                <text class="dm-note" x={r.lx} y={r.ly} text-anchor="middle">{r.note}</text>
              </g>
            ))}

            {pins.map((p) => (
              <g class="dm-town" data-town={p.id}>
                <line class="dm-leader" x1={p.x} y1={p.y} x2={p.cx} y2={p.cy} />
                <circle class="dm-dot" cx={p.x} cy={p.y} r="4" />
              </g>
            ))}
          </svg>

          {pins.map((p) => (
            <a href={`${linkBase}#${p.id}`} class:list={['dm-marker', `side-${p.side}`]} data-id={p.id}
              style={`left:${((p.cx / W) * 100).toFixed(2)}%;top:${((p.cy / H) * 100).toFixed(2)}%`} aria-label={`${p.name} — open on the Destinations page`}>
              <span class="dm-circle"><Photo name={p.photo} alt="" tone={p.tone as any} sizes="120px" /></span>
              <span class="dm-name">{p.name}</span>
            </a>
          ))}
        </div>
        <!-- phones: the map is too small for town names, so list them underneath -->
        <ul class="dm-list">
          {pins.map((p) => (
            <li><a href={`${linkBase}#${p.id}`}>{p.name}</a></li>
          ))}
        </ul>
</div>

<script>
  // Destinations map: hovering a place or a stretch of route lights it up; markers link to the Destinations page
  document.querySelectorAll<HTMLElement>('[data-map]').forEach((dmap) => {
    const markers = [...dmap.querySelectorAll<HTMLElement>('.dm-marker')];
    const towns = [...dmap.querySelectorAll<SVGGElement>('.dm-town')];
    const routesEl = [...dmap.querySelectorAll<SVGGElement>('.dm-route')];
    const light = (ids: string[]) => {
      markers.forEach((m) => m.classList.toggle('on', ids.includes(m.dataset.id!)));
      towns.forEach((t) => t.classList.toggle('on', ids.includes(t.dataset.town!)));
    };
    const select = (id: string) => {
      light([id]);
      routesEl.forEach((r) => { r.classList.toggle('on', r.dataset.a === id || r.dataset.b === id); r.classList.toggle('picked', false); });
    };
    const selectRoute = (r: SVGGElement) => {
      routesEl.forEach((x) => { x.classList.toggle('on', x === r); x.classList.toggle('picked', x === r); });
      light([r.dataset.a!, r.dataset.b!]);
    };
    markers.forEach((m) => {
      m.addEventListener('mouseenter', () => select(m.dataset.id!));
      m.addEventListener('focus', () => select(m.dataset.id!));
    });
    routesEl.forEach((r) => {
      r.addEventListener('click', () => selectRoute(r));
      r.addEventListener('mouseenter', () => selectRoute(r));
      r.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); selectRoute(r); }
      });
    });
    select('thimphu');
  });
</script>

<style>
  .dm-credit { position: absolute; right: 0; bottom: -4px; font-size: 11px; color: var(--ink-mute); }
  .dm-credit a { text-decoration: underline; text-underline-offset: 2px; }
  /* town list — phones only (on bigger screens the names sit beside the photo markers) */
  .dm-list { display: none; }
  @media (max-width: 860px) {
    .dm-credit { position: static; display: block; margin-top: 10px; text-align: right; }
    .dm-list { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin: 22px 0 0; padding: 0; list-style: none; }
    .dm-list a { display: inline-block; padding: 8px 14px; border: 1px solid var(--line); font-family: var(--label); font-size: 12px; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-soft); transition: color 0.3s var(--ease), border-color 0.3s var(--ease); }
    .dm-list a:hover { color: var(--saffron); border-color: var(--saffron); }
  }
  .dm-map { position: relative; max-width: 1080px; width: 100%; margin: 0 auto; }
  .dm-map svg { display: block; width: 100%; height: auto; overflow: visible; }
  .dm-land path { fill: #ece8e1; stroke: #fff; stroke-width: 1.1; stroke-linejoin: round; transition: fill 0.4s var(--ease); }
  .dm-land path:hover { fill: #e6e0d6; }
  .dm-country { font-family: var(--sans); font-size: 30px; font-weight: 400; letter-spacing: 0.32em; text-transform: uppercase; fill: #1f2a33; }

  .dm-journey { fill: none; stroke: #55514b; stroke-width: 1.3; stroke-dasharray: 7 6; stroke-linecap: round; }
  .dm-route { cursor: pointer; outline: none; }
  .dm-hit { fill: none; stroke: transparent; stroke-width: 22; }
  .dm-line { fill: none; stroke: var(--saffron); stroke-width: 2.4; stroke-dasharray: 7 6; stroke-linecap: round; opacity: 0; transition: opacity 0.4s var(--ease); }
  .dm-route.on .dm-line, .dm-route:hover .dm-line, .dm-route:focus-visible .dm-line { opacity: 1; }
  .dm-note { font-family: var(--label); font-size: 13.5px; font-weight: 500; letter-spacing: 0.04em; fill: var(--maroon); paint-order: stroke; stroke: #ece8e1; stroke-width: 6px; stroke-linejoin: round; opacity: 0; transition: opacity 0.35s var(--ease); pointer-events: none; }
  .dm-route:hover .dm-note, .dm-route:focus-visible .dm-note, .dm-route.picked .dm-note { opacity: 1; }

  .dm-leader { stroke: #8f8a82; stroke-width: 0.9; stroke-dasharray: 2 3; transition: stroke 0.3s var(--ease); }
  .dm-dot { fill: #1f2a33; transition: fill 0.3s var(--ease); }
  .dm-town.on .dm-leader { stroke: var(--saffron); }
  .dm-town.on .dm-dot { fill: var(--saffron); }

  /* round photo markers (HTML on top of the SVG) */
  .dm-marker { position: absolute; transform: translate(-50%, -50%); display: flex; align-items: center; gap: 14px; padding: 0; border: 0; background: none; cursor: pointer; }
  .dm-marker.side-left { flex-direction: row-reverse; }
  .dm-circle { position: relative; display: block; width: clamp(46px, 7.6vw, 92px); aspect-ratio: 1; border-radius: 50%; overflow: hidden; flex: none; box-shadow: 0 0 0 0 rgba(154, 106, 30, 0); transition: box-shadow 0.4s var(--ease), transform 0.5s var(--ease); }
  .dm-circle :global(.photo) { position: absolute; inset: 0; }
  .dm-name { font-family: var(--sans); font-size: clamp(10px, 0.95vw, 12.5px); font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: #1f2a33; white-space: nowrap; transition: color 0.3s var(--ease); }
  /* keep the circle itself centred on its point; the name hangs beside it */
  .dm-marker.side-right { transform: translate(calc(-1 * clamp(23px, 3.8vw, 46px)), -50%); }
  .dm-marker.side-left { transform: translate(calc(-100% + clamp(23px, 3.8vw, 46px)), -50%); }
  .dm-marker:hover .dm-circle, .dm-marker:focus-visible .dm-circle { transform: scale(1.08); }
  .dm-marker.on .dm-circle { box-shadow: 0 0 0 3px #fff, 0 0 0 5px var(--saffron); }
  .dm-marker.on .dm-name, .dm-marker:hover .dm-name { color: var(--saffron); }


  @media (max-width: 860px) {
    .dm-name { display: none; }
    .dm-marker.side-right, .dm-marker.side-left { transform: translate(-50%, -50%); }
    .dm-country { font-size: 40px; }
  }
</style>
