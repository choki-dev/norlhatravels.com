---
import { journeys, accommodation } from '../data/journeys.js';
import { styles } from '../data/styles.js';
interface Props { journey?: string; style?: string; id?: string }
const { journey = '', style = '', id = 'enquire' } = Astro.props;
---

<form class="enquiry" id={id} action="/api/enquiry" method="post" data-enquiry>
  <div class="form-grid">
    <div class="field"><label for={`${id}-name`}>Your name *</label><input id={`${id}-name`} name="name" autocomplete="name" required /></div>
    <div class="field"><label for={`${id}-email`}>Email *</label><input id={`${id}-email`} name="email" type="email" autocomplete="email" required /></div>
    <div class="field"><label for={`${id}-country`}>Country of residence</label><input id={`${id}-country`} name="country" autocomplete="country-name" /></div>
    <div class="field"><label for={`${id}-phone`}>Phone / WhatsApp</label><input id={`${id}-phone`} name="phone" type="tel" autocomplete="tel" /></div>
    <div class="field"><label for={`${id}-dates`}>Preferred travel dates</label><input id={`${id}-dates`} name="dates" placeholder="e.g. late March 2027, flexible" /></div>
    <div class="field">
      <label for={`${id}-duration`}>Length of stay</label>
      <select id={`${id}-duration`} name="duration">
        <option value="">Not sure yet</option>
        <option>3–4 days</option><option>5–7 days</option><option>8–10 days</option><option>11–14 days</option><option>More than two weeks</option>
      </select>
    </div>
    <div class="field">
      <label for={`${id}-travellers`}>Number of travelers</label>
      <select id={`${id}-travellers`} name="travellers">
        <option value="">Select</option>
        <option>1</option><option>2</option><option>3–4</option><option>5–8</option><option>More than 8</option>
      </select>
    </div>
    <div class="field">
      <label for={`${id}-accommodation`}>Accommodation</label>
      <select id={`${id}-accommodation`} name="accommodation">
        <option value="">No preference yet</option>
        {accommodation.map((a) => <option>{a.tier}</option>)}
      </select>
    </div>
    <div class="field">
      <label for={`${id}-journey`}>Starting point</label>
      <select id={`${id}-journey`} name="journey">
        <option value="Tailor-made" selected={!journey}>A completely tailor-made journey</option>
        {journeys.map((j) => <option value={j.title} selected={journey === j.title}>{j.title} — {j.days}D/{j.nights}N</option>)}
      </select>
    </div>
    <div class="field">
      <label for={`${id}-style`}>Travel style</label>
      <select id={`${id}-style`} name="style">
        <option value="">Open to ideas</option>
        {styles.map((s) => <option selected={style === s.title}>{s.title}</option>)}
      </select>
    </div>
    <div class="field full">
      <label for={`${id}-message`}>Tell us what inspires you</label>
      <textarea id={`${id}-message`} name="message" placeholder="Your interests, preferred pace, special occasions, the experiences you have in mind…"></textarea>
    </div>
    <div class="hp" aria-hidden="true"><label>Website <input name="website" tabindex="-1" autocomplete="off" /></label></div>
  </div>
  <div class="submit">
    <button class="btn btn-solid" type="submit">Send enquiry <span class="arrow">→</span></button>
    <p class="note">We reply personally, usually within one working day.</p>
  </div>
  <p class="status" role="status" aria-live="polite" data-status></p>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-enquiry]').forEach((form) => {
    // Prefill from links such as /tailor-made/?destination=Punakha or ?style=Family%20Journeys
    const q = new URLSearchParams(location.search);
    const set = (name: string, value: string | null) => {
      if (!value) return;
      const el = form.elements.namedItem(name) as HTMLSelectElement | HTMLTextAreaElement | null;
      if (!el) return;
      if (el instanceof HTMLSelectElement) { if ([...el.options].some((o) => o.value === value)) el.value = value; }
      else if (!el.value) el.value = value;
    };
    set('journey', q.get('journey'));
    set('style', q.get('style'));
    if (q.get('destination')) set('message', `I would love to include ${q.get('destination')} in my journey.`);

    const status = form.querySelector<HTMLElement>('[data-status]')!;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = form.querySelector('button')!;
      btn.disabled = true;
      status.textContent = 'Sending…';
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { accept: 'application/json' } });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.ok) throw new Error(data.error || 'Something went wrong.');
        form.reset();
        form.classList.add('sent');
        status.textContent = 'Thank you. Your enquiry has reached us — we will be in touch personally, very soon.';
      } catch (err) {
        status.textContent = (err as Error).message + ' You can also email us directly.';
      } finally {
        btn.disabled = false;
      }
    });
  });
</script>

<style>
  .submit { display: flex; align-items: center; gap: 28px; flex-wrap: wrap; margin-top: 48px; }
  .note { font-size: 14px; color: var(--ink-mute); margin: 0; }
  .status { margin-top: 24px; font-family: var(--serif); font-size: 22px; font-style: italic; color: var(--pine-2); }
  .status:empty { display: none; }
  button:disabled { opacity: 0.6; cursor: wait; }
</style>
